# Example environment variables for Job Agent
# Copy this file to `.env` and fill in real values before running the agent

# FireCrawl API key (required to enable Wellfound scraping)
FIRECRAWL_API_KEY=

# Optional overrides
#REMOTEOK_API_KEY=
#OUTPUT_PATH=data/jobs.csv
#LOG_LEVEL=INFO
FIRECRAWL_API_KEY=your_firecrawl_api_key
REMOTEOK_API_KEY=
JOB_TITLES=Software Engineer,Data Scientist,Product Manager
OUTPUT_PATH=data/jobs.csv
LOG_LEVEL=INFO
